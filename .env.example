# MongoDB connection string
# For Docker Compose, this is set automatically to: mongodb://mongo:27017/invoice-generator
# For external MongoDB, set your connection string here:
MONGODB_URI=mongodb://mongo:27017/invoice-generator

# Invoice Generator API key (from invoice-generator.com)
INVOICE_GENERATOR_API_KEY=your_api_key_here

# Optional: Port to expose (default 3000)
PORT=3000

# Session lifetime in seconds (default: 30 days). Long sessions keep the
# PWA's notification poller and OS toasts alive.
# AUTH_SESSION_TTL_SECONDS=2592000
